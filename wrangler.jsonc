// Cloudflare Workers Builds: every merge to main runs
//   node scripts/cf-static-assets.mjs --copy --out dist
// (copies only the public site files into dist/ and copies cloudflare/_headers to dist/_headers)
// and then `npx wrangler deploy`. No routes: sotakece.com, www and sere.sotakece.com are attached
// in Cloudflare. /api/* is answered by this Worker's own code (api/*.js, no Vercel) once the
// dimau-api-forwarder routes for these hosts are removed; until then those routes answer /api/*.
// cloudflare/site-worker.js runs first only for the paths in run_worker_first: /api/*, the share links
// /s/, /t/, /p/, /i/ (the same api/listen.js, api/share.js and api/invite.js Vercel ran) and "/"
// (sere.sotakece.com/ opens sere/index.html). Every other path is served straight from dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sotakece",
  "main": "cloudflare/site-worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/s/*", "/t/*", "/p/*", "/i/*", "/api/*"]
  }
}
