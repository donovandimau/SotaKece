{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "has": [
        {
          "type": "host",
          "value": "sotakece.vercel.app"
        }
      ],
      "source": "/(.*)",
      "statusCode": 308,
      "destination": "https://sotakece.com/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "bulavata.vercel.app"
        }
      ],
      "source": "/(.*)",
      "statusCode": 308,
      "destination": "https://sotakece.com/$1"
    }
  ]
}
