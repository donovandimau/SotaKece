{
  "functions": {
    "api/sere.js": { "maxDuration": 60 },
    "api/sere-callback.js": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "sotakece.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://sotakece.com/$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "bulavata.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://sotakece.com/$1" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "sere.sotakece.com" }],
      "dest": "/sere/index.html"
    },
    { "handle": "filesystem" }
  ]
}
